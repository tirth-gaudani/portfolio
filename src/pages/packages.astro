---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { siteConfig, packages, pages } from "../data/siteConfig";

const schema = {
  "@type": ["WebPage", "CollectionPage"],
  mainEntity: {
    "@type": "ItemList",
    itemListElement: packages.map((pkg, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "SoftwareSourceCode",
        name: pkg.name,
        description: pkg.description,
        url: pkg.url,
        programmingLanguage: "JavaScript",
        author: { "@id": `${siteConfig.url}/#person` },
      },
    })),
  },
};
---

<BaseLayout {...pages.packages} crumbs={[{ name: "Packages", path: "/packages/" }]} {schema}>
  <main id="main" class="container">
    <PageHero page={pages.packages} icon="npm" />

    <section aria-labelledby="pkg-title">
      <h2 id="pkg-title" class="sr-only">All packages</h2>
      <ul class="pkg-grid">
        {
          packages.map((pkg) => (
            <li>
              <a href={pkg.url} target="_blank" rel="noopener noreferrer" class="package-card glass reveal" data-tilt>
                <span class="big-icon"><Icon name="npm" size={26} /></span>
                <span>
                  <h3>{pkg.name}</h3>
                  <p>{pkg.description}</p>
                  <code>npm i {pkg.npm}</code>
                </span>
                <span class="arrow-btn" aria-hidden="true"><Icon name="arrow" size={18} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .pkg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .pkg-grid li, .pkg-grid a { height: 100%; }
</style>
