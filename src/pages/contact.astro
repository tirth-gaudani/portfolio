---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { siteConfig, pages } from "../data/siteConfig";

const { email, formEndpoint, formAccessKey, locationText } = siteConfig.contact;
const hasForm = Boolean(email || formEndpoint);
---

<BaseLayout {...pages.contact} crumbs={[{ name: "Contact", path: "/contact/" }]} schema={{ "@type": ["WebPage", "ContactPage"] }}>
  <main id="main" class="container">
    <PageHero page={pages.contact} icon="dot" />

    <div class="contact-grid">
      <aside class="contact-side" aria-label="Contact details">
        {
          email && (
            <a href={`mailto:${email}`} class="info glass" data-tilt>
              <span class="badge-ico"><Icon name="mail" size={16} /></span>
              <span><small>Mail me</small>{email}</span>
            </a>
          )
        }
        <div class="info glass">
          <span class="badge-ico"><Icon name="pin" size={16} /></span>
          <span><small>Location</small>{locationText}</span>
        </div>
        <div class="info glass">
          <span class="badge-ico"><Icon name="sparkle" size={16} /></span>
          <span>
            <small>Find me on</small>
            <span class="socials">
              <a href={siteConfig.social.linkedin} class="icon-btn glass" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" size={18} /></a>
              <a href={siteConfig.social.github} class="icon-btn glass" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" size={18} /></a>
            </span>
          </span>
        </div>
      </aside>

      {
        hasForm ? (
          <form class="contact-form glass" id="contactForm" data-endpoint={formEndpoint} data-key={formAccessKey} data-email={email} novalidate>
            <div class="field"><label for="name">Name</label><input id="name" name="name" placeholder="Your name" required autocomplete="name" /></div>
            <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" placeholder="you@company.com" required autocomplete="email" /></div>
            <div class="field full"><label for="subject">Subject</label><input id="subject" name="subject" placeholder="Project, role or idea" required /></div>
            <div class="field full"><label for="message">Message</label><textarea id="message" name="message" rows="5" placeholder="A few words about what you need…" required></textarea></div>
            <button type="submit" class="btn btn-primary full">Send message <Icon name="send" size={18} /></button>
            <p class="form-status full" role="status" aria-live="polite"></p>
          </form>
        ) : (
          <div class="contact-form glass cta-alt">
            <Icon name="linkedin" size={40} />
            <h2>The fastest way to reach me</h2>
            <p>Send me a message on LinkedIn — I usually reply within a day.</p>
            <a href={siteConfig.social.linkedin} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Message on LinkedIn <Icon name="arrow" size={18} /></a>
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector(".form-status")!;
    const btn = form.querySelector("button")!;
    const { endpoint, key, email } = form.dataset;
    const say = (msg: string, ok = true) => {
      status.textContent = msg;
      status.classList.toggle("error", !ok);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;

      if (!endpoint) {
        const body = `${data.message}\n\n— ${data.name} (${data.email})`;
        location.href = `mailto:${email}?subject=${encodeURIComponent(data.subject)}&body=${encodeURIComponent(body)}`;
        say("Opening your email app…");
        return;
      }

      btn.disabled = true;
      say("Sending…");
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(key ? { ...data, access_key: key } : data),
        });
        if (!res.ok) throw new Error();
        form.reset();
        say("Thank you! Your message has been sent — I'll get back to you soon.");
      } catch {
        say(`Sorry, something went wrong.${email ? ` Please email me at ${email}.` : " Please try again."}`, false);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 24px;
    animation: rise 0.9s var(--ease) 0.1s both;
  }
  .contact-side { display: grid; gap: 16px; align-content: start; }
  .info { display: flex; align-items: center; gap: 16px; padding: 20px; color: var(--text); font-weight: 600; }
  .info small {
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .info .socials { margin-top: 6px; }
  .badge-ico { flex: none; }
  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding: clamp(22px, 4vw, 40px);
    border-radius: var(--r-xl);
  }
  .full { grid-column: 1 / -1; }
  .form-status { min-height: 1.5em; font-weight: 500; color: var(--ok); }
  .form-status.error { color: var(--err); }
  .cta-alt { grid-template-columns: 1fr; justify-items: start; align-content: center; color: var(--text); }
  .cta-alt h2 { font-size: clamp(24px, 3vw, 32px); }

  @media (max-width: 820px) {
    .contact-grid, .contact-form { grid-template-columns: 1fr; }
  }
</style>
