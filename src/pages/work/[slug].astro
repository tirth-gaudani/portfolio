---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { siteConfig, projects } from "../../data/siteConfig";
import { projectArt } from "../../lib/art";

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project: p, next } = Astro.props;
const title = `${p.title} — ${p.category} Project | ${siteConfig.name}`;
const description = p.description.length > 158 ? `${p.description.slice(0, 155).trimEnd()}…` : p.description;
const schema = {
  mainEntity: {
    "@type": "CreativeWork",
    name: p.title,
    description: p.description,
    genre: p.category,
    keywords: p.technologies.join(", "),
    creator: { "@id": `${siteConfig.url}/#person` },
  },
};
---

<BaseLayout {title} {description} imageUrl={`/work/${p.slug}/og.jpg`} imageAlt={`${p.title} — app illustration`} type="article" crumbs={[{ name: "Works", path: "/work/" }, { name: p.title, path: `/work/${p.slug}/` }]} {schema}>
  <main id="main" class="container">
    <a href="/work/" class="btn glass btn-sm back"><Icon name="back" size={16} /> All works</a>

    <section class="detail-top">
      <div class="detail-media glass" data-tilt set:html={projectArt(p)} />
      <div class="detail-info">
        <span class="chip">{p.category}</span>
        <h1>{p.title}</h1>
        <p class="lead">{p.description}</p>
        <ul class="tags" aria-label="Technologies">{p.technologies.map((t) => <li>{t}</li>)}</ul>
        <a href={p.link} class="btn glass" target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} /> View on GitHub</a>
      </div>
    </section>

    <section class="tile glass reveal section" aria-labelledby="highlights">
      <span class="tile-label">Highlights</span>
      <h2 id="highlights">Key features</h2>
      <ul class="features">
        {p.features.map((f) => <li><span class="badge-ico"><Icon name="check" size={14} /></span>{f}</li>)}
      </ul>
    </section>

    <a href={`/work/${next.slug}/`} class="next glass reveal" data-tilt>
      <span class="tile-label">Next project</span>
      <strong>{next.title}</strong>
      <span class="arrow-btn" aria-hidden="true"><Icon name="arrow" size={18} /></span>
    </a>
  </main>
</BaseLayout>

<style>
  .back { margin-bottom: 28px; }
  .detail-top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .detail-media { padding: 10px; border-radius: var(--r-xl); animation: pop 1s var(--spring) both; }
  .detail-media :global(.art) { border-radius: calc(var(--r-xl) - 8px); }
  .detail-info { display: grid; justify-items: start; gap: 18px; animation: rise 0.9s var(--ease) 0.1s both; }
  .detail-info h1 { font-size: clamp(36px, 5vw, 64px); font-weight: 800; }
  .lead { font-size: 17px; }
  .tile h2 { font-size: clamp(24px, 3vw, 32px); }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 14px 24px;
  }
  .features li { display: flex; align-items: center; gap: 12px; color: var(--text); font-weight: 500; }
  .features .badge-ico { width: 28px; height: 28px; flex: none; }
  .next { display: grid; gap: 6px; margin-top: 20px; padding: 28px 80px 28px 28px; border-radius: var(--r-xl); }
  .next strong { font: 800 clamp(28px, 5vw, 48px) / 1.1 var(--font-h); color: var(--text); letter-spacing: -0.03em; }
  .next .arrow-btn { top: 50%; margin-top: -22px; right: 28px; }

  @media (max-width: 860px) {
    .detail-top { grid-template-columns: 1fr; }
    .detail-media { justify-self: center; width: 100%; }
  }
</style>
