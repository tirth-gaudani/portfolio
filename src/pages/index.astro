---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import { siteConfig, projects, packages, currentJob, pages } from "../data/siteConfig";
import { Image } from "astro:assets";

const { stats, photo, expertise, roles, ribbon } = siteConfig;
const [firstName, ...rest] = siteConfig.name.split(" ");
const alt = `${siteConfig.name} — ${siteConfig.role}`;
---

<BaseLayout {...pages.home} type="profile" schema={{ "@type": ["WebPage", "ProfilePage"], mainEntity: { "@id": `${siteConfig.url}/#person` } }}>
  <main id="main">
    <section class="container hero" aria-label="Introduction">
      <div class="hero-copy">
        {siteConfig.available && <span class="chip"><span class="dot"></span> {siteConfig.availability}</span>}
        <h1>{firstName}<br /><span class="grad-text">{rest.join(" ")}.</span></h1>
        <p class="role">
          <span>I'm a</span>
          <span class="sr-only">{roles[0]}</span>
          <span class="words" aria-hidden="true">
            <span>{[...roles, roles[0]].map((r) => <span>{r}</span>)}</span>
          </span>
        </p>
        <p class="hero-desc">{siteConfig.summary}</p>
        <div class="hero-actions">
          <a href="/work/" class="btn btn-primary">View my work <Icon name="arrow" size={18} /></a>
          <a href={siteConfig.resume} class="btn glass" target="_blank" rel="noopener noreferrer">
            <Icon name="download" size={18} /> Download CV
          </a>
        </div>
      </div>

      <div class="stage-wrap">
        <div class="stage">
          <span class="orb orb-1" aria-hidden="true"></span>
          <span class="orb orb-2" aria-hidden="true"></span>

          {
            ["back", "front"].map((layer) => (
              <div class={`orbit-layer orbit-${layer}`} aria-hidden="true">
                <div class="orbit" style={`--n:${expertise.length}`}>
                  {expertise.map((t, i) => (
                    <span class="orbit-item" style={`--i:${i}`}>
                      <span><img src={t.iconSrc} alt="" width="24" height="24" loading="lazy" decoding="async" /></span>
                    </span>
                  ))}
                </div>
              </div>
            ))
          }

          <div class="portrait glass" data-tilt>
            <div class="portrait-inner">
              <Image src={photo.dark} {alt} width={440} height={440} loading="eager" fetchpriority="high" class="only-dark" />
              <Image src={photo.light} {alt} width={440} height={440} loading="lazy" class="only-light" />
            </div>
          </div>

          <div class="badge glass badge-a">
            <span class="badge-ico"><Icon name="sparkle" size={16} /></span>
            <span><strong>{stats.years}+ years</strong>Experience</span>
          </div>
          <div class="badge glass badge-b">
            <span class="badge-ico"><Icon name="npm" size={16} /></span>
            <span><strong>{packages.length} packages</strong>on npm</span>
          </div>
        </div>
      </div>
    </section>

    <div class="ribbon glass" aria-hidden="true">
      <div class="ribbon-track">
        {[0, 1].map(() => ribbon.map((w) => <span>{w}<Icon name="sparkle" size={22} /></span>))}
      </div>
    </div>

    <section class="container section" aria-labelledby="glance-title">
      <h2 id="glance-title" class="sr-only">At a glance</h2>
      <div class="bento">
        <div class="tile glass stat reveal">
          <span class="tile-label">Years of experience</span>
          <span class="stat-num"><span data-count={stats.years} data-pad="2">{String(stats.years).padStart(2, "0")}</span><sup>+</sup></span>
        </div>
        <div class="tile glass stat reveal">
          <span class="tile-label">Projects delivered</span>
          <span class="stat-num"><span data-count={stats.projects}>{stats.projects}</span><sup>+</sup></span>
        </div>
        <a href="/about/" class="tile glass span-2 reveal" data-tilt>
          <span class="tile-label">Currently</span>
          <h3>{currentJob.title}</h3>
          <p>@ {currentJob.company} — building scalable products end-to-end with React, Node.js and modern databases.</p>
          <span class="link-arrow tile-foot">More about me <Icon name="arrow" size={16} /></span>
        </a>

        <a href="/packages/" class="tile glass span-2 reveal" data-tilt>
          <span class="big-icon"><Icon name="npm" size={34} /></span>
          <div class="tile-foot">
            <span class="tile-label">Open source</span>
            <h3>{packages.length} npm packages for developers</h3>
          </div>
          <span class="arrow-btn" aria-hidden="true"><Icon name="arrow" size={18} /></span>
        </a>
        <div class="tile glass stat reveal">
          <span class="tile-label">Happy clients</span>
          <span class="stat-num"><span data-count={stats.clients}>{stats.clients}</span><sup>+</sup></span>
        </div>
        <a href="/contact/" class="tile glass cta-tile reveal" data-tilt>
          <span class="tile-label">Let's talk</span>
          <h3 class="tile-foot">Work<br />together.</h3>
          <span class="arrow-btn" aria-hidden="true"><Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </section>

    <section class="container section" aria-labelledby="work-title">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow"><Icon name="sparkle" size={12} /> Selected work</span>
          <h2 id="work-title">Things I've <span class="grad-text">built</span></h2>
        </div>
        <a href="/work/" class="link-arrow">View all projects <Icon name="arrow" size={16} /></a>
      </div>
      <div class="projects-grid">
        {projects.slice(0, 3).map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </section>
  </main>
</BaseLayout>
