---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig, experience, education } from "../data/siteConfig";
import { Image } from "astro:assets";
import profileDark from "../assets/img/profile-dark.png";
import profileLight from "../assets/img/profile-light.png";
import profileOg from "../assets/img/profile-light.png";

const pageTitle = `About - ${siteConfig.name} | ${siteConfig.profile.role}`;
const pageDescription = `Learn about ${siteConfig.name}, a passionate MERN Stack Developer with expertise in React, Node.js, MongoDB, and Express.js. View experience, education, and skills.`;

// About page structured data
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: `About ${siteConfig.name}`,
  description: pageDescription,
  mainEntity: {
    "@type": "Person",
    name: siteConfig.name,
    jobTitle: siteConfig.profile.role,
    description: siteConfig.profile.aboutSummary,
    image: `${siteConfig.url}/img/profile-light.png`,
    url: `${siteConfig.url}/about`,
    sameAs: Object.values(siteConfig.social),
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={aboutSchema}
  ogImage={profileOg}
>
  <main class="gridx-main page-full">
    <!-- PAGE TITLE -->
    <h1 class="page-title">
      <span class="star-icon">✸</span> SELF-SUMMARY <span class="star-icon"
        >✸</span
      >
    </h1>

    <!-- ABOUT HERO -->
    <section class="about-hero" aria-label="About Me">
      <div class="about-image-card">
        <div class="profile-img">
          <Image
            src={profileDark}
            alt={`${siteConfig.name} - Full Stack Developer`}
            width={320}
            height={400}
            loading="eager"
            decoding="async"
            class="logo-img--dark"
          />
          <Image
            src={profileLight}
            alt={`${siteConfig.name} - Full Stack Developer`}
            width={320}
            height={400}
            loading="eager"
            decoding="async"
            class="logo-img--light"
          />
        </div>
      </div>

      <div class="about-bio">
        <h2 class="about-name">{siteConfig.name}</h2>
        <p class="about-text">
          {siteConfig.profile.aboutSummary}
        </p>
      </div>
    </section>

    <!-- EXPERIENCE & EDUCATION -->
    <section class="about-timeline" aria-label="Experience and Education">
      <div class="timeline-col">
        <h3 class="timeline-heading">EXPERIENCE</h3>
        {
          experience.map((item) => (
            <div class="timeline-entry">
              <span class="timeline-date">{item.date}</span>
              <h4 class="timeline-title">{item.title}</h4>
              <p class="timeline-company">{item.company}</p>
            </div>
          ))
        }
      </div>

      <div class="timeline-col">
        <h3 class="timeline-heading">EDUCATION</h3>
        {
          education.map((item) => (
            <div class="timeline-entry">
              <span class="timeline-date">{item.date}</span>
              <h4 class="timeline-title">{item.title}</h4>
              <p class="timeline-company">{item.company}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .star-icon {
    font-size: 0.6em;
    color: var(--accent);
    animation: spin 10s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
