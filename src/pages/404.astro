---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { pages } from "../data/siteConfig";
---

<BaseLayout {...pages.notFound} noindex>
  <main id="main" class="container">
    <section class="page-hero lost">
      <div class="big404 glass" data-tilt aria-hidden="true"><span class="grad-text">404</span></div>
      <h1>Lost in space.</h1>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="btn btn-primary"><Icon name="home" size={18} /> Back to home</a>
    </section>
  </main>
</BaseLayout>

<style>
  .lost { min-height: 60vh; align-content: center; }
  .lost h1 { font-size: clamp(32px, 5vw, 52px); }
  .big404 {
    padding: 10px 40px;
    border-radius: var(--r-xl);
    font: 800 clamp(96px, 20vw, 200px) / 1 var(--font-h);
    letter-spacing: -0.06em;
  }
</style>
