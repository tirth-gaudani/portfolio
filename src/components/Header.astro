---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import logoLight from "../assets/img/tg-logo-light.png";
import logoDark from "../assets/img/tg-logo-dark.png";
import { navigation, siteConfig } from "../data/siteConfig";

const trim = (p: string) => p.replace(/\/$/, "") || "/";
const path = trim(Astro.props.currentPath);
const isActive = (href: string) => (href === "/" ? path === "/" : path === trim(href) || path.startsWith(href));
const links = [...navigation, { name: "Contact", href: "/contact/" }];
---

<header class="site-header" id="siteHeader">
  <div class="nav-shell glass">
    <a href="/" class="brand" aria-label={`${siteConfig.name} — Home`}>
      <Image class="only-light" src={logoLight} alt="" width={40} loading="eager" />
      <Image class="only-dark" src={logoDark} alt="" width={40} loading="eager" />
      <span>{siteConfig.name}</span>
    </a>

    <nav class="nav" aria-label="Main">
      {navigation.map((l) => <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.name}</a>)}
    </nav>

    <div class="nav-actions">
      <button class="icon-btn glass" id="themeToggle" type="button" aria-label="Light theme" aria-pressed="false">
        <Icon name="sun" class="only-dark" />
        <Icon name="moon" class="only-light" />
      </button>
      <a href="/contact/" class="btn btn-primary btn-sm hide-sm">Hire me</a>
      <button class="icon-btn glass menu-btn" id="menuBtn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Menu">
  <button class="icon-btn glass menu-close" id="menuClose" type="button" aria-label="Close menu">
    <Icon name="close" />
  </button>
  <nav aria-label="Mobile">
    {links.map((l, i) => <a href={l.href} style={`--i:${i}`} aria-current={isActive(l.href) ? "page" : undefined}>{l.name}</a>)}
  </nav>
</div>
