---
import Icon from "./Icon.astro";
import { siteConfig, navigation } from "../data/siteConfig";
---

<footer class="site-footer container">
  <div class="footer-bar glass">
    <p class="footer-copy">© {new Date().getFullYear()} {siteConfig.name}</p>
    <nav class="footer-nav" aria-label="Footer">
      {[...navigation, { name: "Contact", href: "/contact/" }].map((l) => <a href={l.href}>{l.name}</a>)}
    </nav>
    <div class="socials">
      <a href={siteConfig.social.linkedin} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" size={16} /></a>
      <a href={siteConfig.social.github} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" size={16} /></a>
    </div>
  </div>
</footer>
