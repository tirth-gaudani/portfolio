---
import { Image } from "astro:assets";
import CardArrow from "./CardArrow.astro";
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    category: string;
    image: string | ImageMetadata | any;
    slug: string;
    gradient: string;
    large?: boolean;
}

const { title, category, image, slug, gradient, large } = Astro.props;
---

<a
    href={`/work/${slug}`}
    class:list={["project-card", { "project-card-large": large }]}
>
    <div class="card-inner">
        <div class="image-container" style={`background: ${gradient}`}>
            <Image
                src={image}
                alt={title}
                width={800}
                height={600}
                loading="lazy"
                decoding="async"
            />
            <div class="overlay"></div>
        </div>
        <div class="content">
            <div class="info">
                <span class="category">{category}</span>
                <h3 class="title">{title}</h3>
            </div>
            <CardArrow />
        </div>
    </div>
</a>

<style>
    .project-card {
        display: block;
        position: relative;
        border-radius: var(--radius-lg);
        overflow: hidden;
        text-decoration: none;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); /* Smoother */
        height: 100%;
        min-height: 280px; /* Reduced from 340px */
    }

    .project-card:hover {
        border-color: var(--border-hover);
        transform: translateY(-8px); /* More pronounced lift */
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15); /* Stronger shadow */
    }

    .card-inner {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .image-container {
        height: 180px; /* Fixed small height for "little small" feel */
        width: 100%;
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid var(--border-color);
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .project-card:hover .image-container img {
        transform: scale(1.1); /* Zoom effect */
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(0, 0, 0, 0.3) 100%
        );
        opacity: 0;
        transition: var(--transition);
    }

    .project-card:hover .overlay {
        opacity: 1;
    }

    .content {
        flex: 1;
        padding: 20px; /* Reduced padding */
        display: flex;
        align-items: center; /* Center vertically */
        justify-content: space-between;
        background: var(--bg-card);
        position: relative;
    }

    .info {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .category {
        font-size: 11px;
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 1px;
        background: rgba(123, 104, 238, 0.08);
        padding: 4px 8px;
        border-radius: 6px;
        width: fit-content;
    }

    .title {
        font-size: 18px; /* Slightly smaller for compact feel */
        font-weight: 600;
        color: var(--text-white);
        margin: 0;
        line-height: 1.3;
    }

    .arrow-container {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        background: var(--bg-body);
        transition: var(--transition);
    }
</style>
