---
import Icon from "./Icon.astro";
import { projectArt } from "../lib/art";
import type { Project } from "../data/siteConfig";

interface Props {
  project: Project;
  index?: number;
}

const { project: p, index = 0 } = Astro.props;
---

<a href={`/work/${p.slug}/`} class="project-card glass reveal" data-tilt style={`--d:${index * 60}ms`}>
  <div class="project-media" set:html={projectArt(p)} />
  <div class="project-body">
    <span class="chip">{p.category}</span>
    <h3>{p.title}</h3>
    <ul class="tags" aria-label="Technologies">
      {p.technologies.slice(0, 3).map((t) => <li>{t}</li>)}
    </ul>
  </div>
  <span class="arrow-btn" aria-hidden="true"><Icon name="arrow" size={18} /></span>
</a>
